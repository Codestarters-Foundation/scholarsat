# Copy to .env on the server. Never commit .env.
DOMAIN=scholarsat.com
SITE_URL=https://scholarsat.com
# Before DNS points at the server, serve over plain HTTP on the IP:
#   CADDYFILE=Caddyfile.ip
#   INSECURE_COOKIES=1
# Remove both lines once DNS is live; Caddy then gets HTTPS certificates automatically.
NEXT_PUBLIC_REPO_URL=https://github.com/Codestarters-Foundation/scholarsat
# Google sign-in (optional; the button only appears when both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URIs: https://scholarsat.com/api/auth/google/callback
#                           http://localhost:3000/api/auth/google/callback   (local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Desmos graphing calculator in the practice player and tests (free key: https://www.desmos.com/api/v1.11/docs/index.html).
# Without it, the Calculator button opens desmos.com in a new tab. Inlined at build time.
NEXT_PUBLIC_DESMOS_API_KEY=
