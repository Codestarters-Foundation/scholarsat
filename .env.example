# Copy to .env on the server. Never commit .env.
DOMAIN=scholarsat.com
SITE_URL=https://scholarsat.com
# Before DNS points at the server, serve over plain HTTP on the IP:
#   CADDYFILE=Caddyfile.ip
#   INSECURE_COOKIES=1
# Remove both lines once DNS is live; Caddy then gets HTTPS certificates automatically.
NEXT_PUBLIC_REPO_URL=https://github.com/smaranz/scholarsat
